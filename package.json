{
  "name": "test-crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:reset": "supabase db reset",
    "db:seed:users": "node --env-file=.env supabase/seed/users.mjs",
    "db:seed:demo": "node --env-file=.env supabase/seed/demo-data.mjs",
    "db:seed": "pnpm db:seed:users && pnpm db:seed:demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.119.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
