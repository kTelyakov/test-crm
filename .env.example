# Локальное окружение для скриптов БД и e2e-тестов. Копия этого файла: .env (в git не попадает).
# Значения для локального Supabase выводит команда: pnpm exec supabase status -o env

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Нужен ТОЛЬКО скрипту создания тестовых пользователей (supabase/seed). Приложение его не использует.
SUPABASE_SERVICE_ROLE_KEY=

# Пароль тестовых пользователей
TEST_USER_PASSWORD=

# Прямое подключение к тестовой базе (нужно одному e2e-тесту атомарности; локальный адрес Supabase)
DB_URL=
